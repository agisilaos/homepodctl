#!/usr/bin/env python3
"""Start an isolated task, qualify a fast-forward to main, or end a landed task."""

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import tempfile


MAIN = "refs/heads/main"
TRACKING = "refs/remotes/origin/main"
LANDING = "HOMEPODCTL_LANDING"
RECEIPT = "HOMEPODCTL_LANDING_RECEIPT"
DESTINATION = "HOMEPODCTL_LANDING_DESTINATION"
OWNER = "homepodctl.sessionBranch"
SESSION_BASE = "homepodctl.sessionBase"
CLEAN_REVIEW = {"status": "clean", "report": ""}
TOOL_OVERRIDES = ("BASH_ENV", "ENV", "BASHOPTS", "SHELLOPTS", "GIT_EXTERNAL_DIFF",
                  "GIT_DIFF_OPTS", "GOFLAGS", "MFLAGS")
BUILD_OUTPUTS = {"homepodctl", "dist/verify/homepodctl"}
OPERATIONS = (
    "rebase-merge", "rebase-apply", "sequencer", "MERGE_HEAD",
    "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_START",
)


class SessionError(Exception):
    pass


def git(*args, cwd=None, env=None):
    return subprocess.run(
        ["git", *args], cwd=cwd, env=env, check=True, stdout=subprocess.PIPE, text=True
    ).stdout.rstrip("\n")


def config(key, cwd=None):
    result = subprocess.run(
        ["git", "config", "--get", key], cwd=cwd, stdout=subprocess.PIPE, text=True
    )
    if result.returncode == 1:
        return None
    result.check_returncode()
    return result.stdout.rstrip("\n")


def git_path(name, cwd=None):
    return Path(git("rev-parse", "--path-format=absolute", "--git-path", name, cwd=cwd))


def checkout_environment_keys():
    return [*git("rev-parse", "--local-env-vars").splitlines(), LANDING, RECEIPT, DESTINATION]


def has_session_script(base):
    return git("ls-tree", base, "--", "scripts/session").startswith("100755 blob ")


def compatible_hooks(root, common):
    hooks = git_path("homepodctl-session-hooks", root)
    configured = config("core.hooksPath", root)
    if configured is not None and configured != str(hooks):
        raise SessionError("this worktree has a custom hooks path; integrate the session gate first")
    default_hooks = common / "hooks"
    if configured is None and default_hooks.is_dir() and any(
        path.is_file() and os.access(path, os.X_OK)
        for path in default_hooks.iterdir()
        if not path.name.endswith(".sample")
    ):
        raise SessionError("this repository has active Git hooks; integrate the session gate first")
    return hooks


def install_gate(root, common, base, branch, bootstrap=None):
    hooks = compatible_hooks(root, common)
    if config("extensions.worktreeConfig", root) != "true":
        if config("core.worktree", root) is not None or config("core.bare", root) == "true":
            raise SessionError("worktree-scoped hooks require a standard non-bare repository")
        git("config", "--local", "extensions.worktreeConfig", "true", cwd=root)

    # Copy from main so rebasing or editing the task cannot replace its push gate.
    source = bootstrap if bootstrap is not None else subprocess.check_output(
        ["git", "show", f"{base}:scripts/session"]
    )
    hooks.mkdir(exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=hooks, delete=False) as launcher:
        launcher.write(source)
        temporary = Path(launcher.name)
    try:
        temporary.chmod(0o755)
        temporary.replace(hooks / "pre-push")
    finally:
        temporary.unlink(missing_ok=True)
    git("config", "--worktree", OWNER, branch, cwd=root)
    git("config", "--worktree", SESSION_BASE, base, cwd=root)
    git("config", "--worktree", "hook.pre-push.enabled", "true", cwd=root)
    git("config", "--worktree", "core.hooksPath", str(hooks), cwd=root)


def git_config_environment(settings):
    env = {**os.environ, "GIT_CONFIG_COUNT": str(len(settings))}
    for index, (key, value) in enumerate(settings):
        env[f"GIT_CONFIG_KEY_{index}"] = key
        env[f"GIT_CONFIG_VALUE_{index}"] = value
    return env


def pinned_remote(destination):
    # Git expands a URL alias once. Mapping a fresh alias to the already
    # resolved URL avoids applying the user's rewrite rules a second time.
    alias = f"homepodctl:{secrets.token_hex(16)}"
    env = git_config_environment([
        (f"url.{destination}.insteadOf", alias),
        (f"url.{destination}.pushInsteadOf", alias),
    ])
    return env, alias


def fetch_main(destination=None):
    env, address = pinned_remote(destination) if destination else (None, "origin")
    snapshot = f"refs/worktree/homepodctl/main-{secrets.token_hex(16)}"
    try:
        git(
            "fetch", "--quiet", "--no-tags", "--no-write-fetch-head", "--refmap=",
            "--", address, f"{MAIN}:{snapshot}", env=env,
        )
        return git("rev-parse", "--verify", f"{snapshot}^{{commit}}")
    finally:
        git("update-ref", "-d", snapshot)


def require_clean():
    if any(git_path(state).exists() for state in OPERATIONS):
        raise SessionError("finish the Git operation in progress first")
    if git("status", "--porcelain", "--untracked-files=all"):
        raise SessionError("the worktree has uncommitted changes")


def require_no_grafts():
    if git_path("info/grafts").exists():
        raise SessionError("remove local Git grafts first")


def check_ancestry(ancestor, descendant):
    return subprocess.run(
        ["git", "-c", "advice.graftFileDeprecated=false", "merge-base",
         "--is-ancestor", ancestor, descendant],
        env={**os.environ, "GIT_GRAFT_FILE": os.devnull},
    )


def refresh_tracking_ref(destination, observed):
    if git("remote", "get-url", "origin") != destination:
        return
    found = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", TRACKING],
        stdout=subprocess.PIPE, text=True,
    )
    if found.returncode != 1:
        found.check_returncode()
    current = found.stdout.strip()
    if current == observed:
        return
    if current:
        ancestor = check_ancestry(current, observed)
        if ancestor.returncode == 1:
            return
        ancestor.check_returncode()
    # A concurrent fetch may have refreshed the shared ref already.
    subprocess.run(["git", "update-ref", TRACKING, observed, current], check=False)


def protect_local_files(cwd=None):
    for entry in git("ls-files", "-v", "-z", cwd=cwd).split("\0"):
        if entry.startswith("S ") or entry[:1].islower():
            raise SessionError(f"clear Git index flags first, including {entry[2:]!r}")
    for path in git("ls-files", "--others", "--ignored", "--exclude-standard", "-z", cwd=cwd).split("\0"):
        if path and path not in BUILD_OUTPUTS:
            raise SessionError(f"move ignored local files first, including {path!r}")


def local_ref_exists(ref):
    return ref in git("for-each-ref", "--format=%(refname)", ref).splitlines()


def registered_checkout(pointer):
    return (pointer.parent / pointer.read_text().rstrip("\n")).resolve().parent


@contextmanager
def session_lock(common, name):
    with (common / f"homepodctl-{name}.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def require_retained_base(branch_ref, base, adoption_base):
    previous = config(SESSION_BASE)
    if adoption_base is not None:
        if previous is not None:
            raise SessionError("this worktree already has a recorded session base")
        previous = git("rev-parse", "--verify", "--end-of-options", f"{adoption_base}^{{commit}}")
        tip = git("rev-parse", "--verify", branch_ref)
        original = check_ancestry(previous, tip)
        if original.returncode == 1:
            raise SessionError("the supplied starting base is outside the task branch history")
        original.check_returncode()
    elif previous is None:
        history = git("reflog", "show", "--format=%H", branch_ref).splitlines()
        if not history:
            raise SessionError("could not establish the task's starting base")
        initial = history[-1]
        initial_is_on_main = check_ancestry(initial, base)
        if initial_is_on_main.returncode == 1:
            raise SessionError("could not verify the task's starting base; pass --base with its known main commit")
        initial_is_on_main.check_returncode()
        previous = initial
    retained = check_ancestry(previous, base)
    if retained.returncode == 1:
        raise SessionError("origin/main no longer contains the recorded session base")
    retained.check_returncode()


def session_branch(root, primary):
    if root == primary:
        raise SessionError("run this from a linked task worktree")
    branch = git("branch", "--show-current")
    if not branch or branch in {"main", "master"}:
        raise SessionError("check out a task branch first")
    owner = config(OWNER)
    if owner is not None and owner != branch:
        raise SessionError(f"this session owns {owner}; check it out first")
    return branch


def start(name, common, primary):
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name):
        raise SessionError("use a lowercase task name such as fix-playback-help")
    path = primary.with_name(f"{primary.name}-{name}")
    branch = f"fix/{name}"
    branch_ref = f"refs/heads/{branch}"
    base = fetch_main()
    if not has_session_script(base):
        raise SessionError("origin/main needs an executable scripts/session before starting tasks")
    if path.exists() or path.is_symlink() or local_ref_exists(branch_ref):
        raise SessionError(f"{path} or {branch} already exists")
    compatible_hooks(primary, common)
    scratch = Path(tempfile.mkdtemp(prefix=".homepodctl-start-", dir=primary.parent))
    staging = scratch / path.name
    pointer = None
    try:
        git("worktree", "add", "--quiet", "--detach", str(staging), base, cwd=primary)
        pointer = git_path("gitdir", staging)
        install_gate(staging, common, base, branch)
        git("worktree", "move", str(staging), str(path))
        if registered_checkout(pointer) != path:
            raise SessionError(f"{path} became occupied while starting the session")
        git("switch", "--quiet", "--no-track", "-c", branch, cwd=path)
    except (SessionError, OSError, subprocess.CalledProcessError):
        try:
            owned = registered_checkout(pointer) if pointer is not None and pointer.is_file() else staging
            worktrees = git("worktree", "list", "--porcelain", "-z").split("\0")
            if f"worktree {owned}" in worktrees:
                protect_local_files(owned)
                archived = retire_checkout(owned, primary, "", base)
                print(f"Staged worktree files moved to {archived}", file=sys.stderr)
            elif staging.exists() or local_ref_exists(branch_ref):
                print(f"Session setup failed. Inspect {staging} and {branch} before retrying.", file=sys.stderr)
        except (SessionError, OSError, subprocess.CalledProcessError):
            print(f"Session setup failed. Inspect {path}, {staging} and {branch} before retrying.", file=sys.stderr)
        raise
    finally:
        if not any(scratch.iterdir()):
            scratch.rmdir()
    print(path)


def land(root, common, primary, dry_run, adoption_base):
    require_clean()
    branch = session_branch(root, primary)
    branch_ref = f"refs/heads/{branch}"
    print("Waiting for the landing lock", file=sys.stderr, flush=True)
    with session_lock(common, "landing"):
        require_clean()
        if session_branch(root, primary) != branch:
            raise SessionError("the task branch changed while waiting")
        require_no_grafts()
        hooks = compatible_hooks(root, common)
        destination = git("remote", "get-url", "origin")
        if git("remote", "get-url", "--push", "--all", "origin") != destination:
            raise SessionError("origin must have the same single fetch and push destination")
        original = git("rev-parse", branch_ref)
        base = fetch_main(destination=destination)
        require_clean()
        if session_branch(root, primary) != branch or git("rev-parse", branch_ref) != original:
            raise SessionError("the task branch changed during fetch")
        require_retained_base(branch_ref, base, adoption_base)
        # The first landing has no installed version on main yet.
        bootstrap = None
        if not has_session_script(base):
            if git("rev-parse", "--is-shallow-repository") == "true":
                raise SessionError("first landing requires complete main history")
            if git("log", "--full-history", "-1", "--format=%H", base, "--", "scripts/session"):
                raise SessionError("origin/main removed or disabled scripts/session")
            bootstrap = Path(__file__).read_bytes()
        if git("rev-list", "--merges", f"{base}..HEAD"):
            raise SessionError("make the task history linear before landing")
        # Record the fetched target so a manual rebase cannot later land after
        # main is rewound past the base the user was asked to integrate.
        install_gate(root, common, base, branch, bootstrap)
        based_on_main = check_ancestry(base, original)
        if based_on_main.returncode == 1:
            raise SessionError(f"the task is behind origin/main; rebase onto {base} before landing")
        based_on_main.check_returncode()
        head = git("rev-parse", branch_ref)
        require_clean()
        if session_branch(root, primary) != branch or git("rev-parse", "HEAD") != head:
            raise SessionError("the task branch changed before qualification")
        if head == base:
            if not dry_run:
                refresh_tracking_ref(destination, base)
            print(f"Already on origin/main at {head}")
            return
        # Qualification establishes ancestry in the isolated clone. The
        # lease then checks the old ref atomically, even if Git skips its hook.
        transport_env, address = pinned_remote(destination)
        command = [
            "git", "-c", f"core.hooksPath={hooks}", "-c", "hook.pre-push.enabled=true",
            "push", "--porcelain", "--no-follow-tags", f"--force-with-lease={MAIN}:{base}",
        ]
        if dry_run:
            command.append("--dry-run")
        with tempfile.TemporaryDirectory(prefix="homepodctl-land-", dir=git_path("HEAD").parent) as state:
            receipt = Path(state) / "checked"
            expected = f"{base} {head}"
            qualification = subprocess.run(
                [str(hooks / "pre-push"), "--qualify", base, head, str(receipt)],
                env={**os.environ, DESTINATION: destination},
            )
            if qualification.returncode:
                raise SessionError(f"qualification exited {qualification.returncode}; see the diagnostics above")
            if not receipt.is_file() or receipt.read_text() != expected:
                raise SessionError("the gate did not qualify these commits")
            require_clean()
            if session_branch(root, primary) != branch or git("rev-parse", "HEAD") != head:
                raise SessionError("the task branch changed after qualification")
            pushed = subprocess.run(
                [*command, "--", address, f"{head}:{MAIN}"],
                env={**transport_env, LANDING: expected, RECEIPT: str(receipt), DESTINATION: destination},
                stdout=subprocess.PIPE, text=True,
            )
            print(pushed.stdout, end="")
            pushed.check_returncode()
        updates = []
        for line in pushed.stdout.splitlines():
            fields = line.split("\t", 2)
            if len(fields) == 3 and fields[1].endswith(f":{MAIN}"):
                updates.append(fields[0])
        if len(updates) != 1:
            raise SessionError("could not determine the push result; check origin/main")
        if dry_run:
            verify_remote_base(destination, base)
            print(f"Dry run passed for {head}")
        else:
            observed = fetch_main(destination=destination)
            check_ancestry(head, observed).check_returncode()
            refresh_tracking_ref(destination, observed)
            if updates[0] == "=":
                print(f"Already on origin/main at {head}")
            else:
                print(f"Landed {head} on origin/main")


def run_logged(command, path, checkout, timeout=None):
    # Git exports checkout-specific variables to hooks. Tools that start Git in
    # another directory must discover that repository independently.
    env = {
        key: value for key, value in os.environ.items()
        if not key.startswith(("BASH_FUNC_", "MAKE", "GNUMAKE"))
    }
    for key in (*checkout_environment_keys(), *TOOL_OVERRIDES):
        env.pop(key, None)
    env.update({
        "GOENV": "off",
        "GOWORK": "off",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_CONFIG_SYSTEM": os.devnull,
        "GIT_ATTR_NOSYSTEM": "1",
    })
    with path.open("a") as output:
        try:
            result = subprocess.run(
                command, stdin=subprocess.DEVNULL, stdout=output,
                stderr=subprocess.STDOUT, cwd=checkout, timeout=timeout, env=env
            )
        except subprocess.TimeoutExpired as error:
            raise SessionError(f"{command[0]} timed out. Log: {path}") from error
    if result.returncode != 0:
        raise SessionError(f"{command[0]} exited {result.returncode}. Log: {path}")


def review(base, head, logs, checkout):
    schema = logs / "review-schema.json"
    schema.write_text(json.dumps({
        "type": "object",
        "properties": {
            "status": {"type": "string", "enum": ["clean", "findings", "incomplete"]},
            "report": {"type": "string"},
        },
        "required": ["status", "report"],
        "additionalProperties": False,
    }))
    verdict = logs / "review.json"
    transcript = logs / "review.log"
    prompt = (
        f"Review the committed homepodctl change from {base} to {head}. "
        f"Read AGENTS.md and inspect git diff --no-ext-diff --no-textconv {base} {head} "
        "and affected code and tests. "
        "Review for actionable regressions and repository standards. Change no files. "
        "Use findings with file, line and consequence for defects, or incomplete with "
        "the reason if you cannot finish. Use clean with an empty report only after "
        "completing the review and finding no actionable regressions."
    )
    run_logged([
        os.environ.get("HOMEPODCTL_CODEX", "codex"), "exec", "--ephemeral",
        "--sandbox", "read-only", "--output-schema", str(schema),
        "--output-last-message", str(verdict), prompt,
    ], transcript, checkout, timeout=900)
    try:
        answer = json.loads(verdict.read_text())
    except (OSError, ValueError) as error:
        raise SessionError(f"Codex returned no usable review. Log: {transcript}") from error
    if answer != CLEAN_REVIEW:
        raise SessionError(f"Codex did not return a clean review. Verdict: {verdict}")


def pre_push(destination):
    for line in sys.stdin:
        _, head, remote_ref, base = line.split()
        if remote_ref != MAIN:
            continue
        expected = f"{base} {head}"
        receipt = os.environ.get(RECEIPT)
        if (destination != os.environ.get(DESTINATION)
                or os.environ.get(LANDING) != expected or not receipt):
            raise SessionError("use scripts/session land; main may have moved since the rebase")
        if Path(receipt).read_text() != expected:
            raise SessionError("the outgoing update does not match the qualified commits")


def qualify(base, head, receipt):
    destination = os.environ[DESTINATION]
    default_logs = Path.home() / "Library/Logs/homepodctl/threads"
    log_root = (Path(os.environ.get("HOMEPODCTL_SESSION_LOG_DIR", default_logs))
                / Path.cwd().name).resolve()
    if any((directory / ".git").exists() for directory in (log_root, *log_root.parents)):
        raise SessionError("store session evidence outside Git checkouts")
    log_root.mkdir(parents=True, exist_ok=True)
    logs = Path(tempfile.mkdtemp(prefix="land-", dir=log_root))
    print(f"Review and verification logs: {logs}", file=sys.stderr, flush=True)
    with tempfile.TemporaryDirectory(prefix="homepodctl-check-") as state:
        checkout = Path(state) / "checkout"
        common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
        setup_log = logs / "checkout.log"
        run_logged(
            ["git", "clone", "--quiet", "--shared", "--no-checkout", "--no-tags",
             "--template=", "--", common, str(checkout)],
            setup_log, checkout.parent,
        )
        for args in (
            ["config", "--local", "core.attributesFile", os.devnull],
            ["update-ref", TRACKING, base],
            ["checkout", "--quiet", "--detach", head],
            ["merge-base", "--is-ancestor", base, head],
        ):
            run_logged(["git", *args], setup_log, checkout)
        review(base, head, logs, checkout)
        verify_remote_base(destination, base)
        run_logged(["make", "-f", "Makefile", "verify"], logs / "verify.log", checkout)
    verify_remote_base(destination, base)
    Path(receipt).write_text(f"{base} {head}")
    print("Codex review and make verify passed", file=sys.stderr)


def verify_remote_base(destination, base):
    env, address = pinned_remote(destination)
    if git("ls-remote", "--exit-code", "--", address, MAIN, env=env) != f"{base}\t{MAIN}":
        raise SessionError("origin/main moved during landing; land again")


def retire_checkout(root, primary, branch, head):
    trash = Path(os.environ.get("HOMEPODCTL_SESSION_TRASH_DIR", Path.home() / ".Trash")).resolve()
    if any((directory / ".git").exists() for directory in (trash, *trash.parents)):
        raise SessionError("use a Trash directory outside Git checkouts")
    trash.mkdir(parents=True, exist_ok=True)
    slot = Path(tempfile.mkdtemp(prefix=f"{root.name}-", dir=trash))
    registered = slot / "registered"
    archived = slot / "files"
    try:
        git("worktree", "move", str(root), str(registered), cwd=primary)
    except subprocess.CalledProcessError:
        if not any(slot.iterdir()):
            slot.rmdir()
        raise

    # Unregister a missing path so Git never recursively deletes the files.
    try:
        if (git("branch", "--show-current", cwd=registered) != branch
                or git("rev-parse", "HEAD", cwd=registered) != head):
            raise SessionError("the task branch changed during cleanup")
        registered.rename(archived)
        git("worktree", "remove", str(registered), cwd=primary)
    except (SessionError, OSError, subprocess.CalledProcessError):
        try:
            if archived.exists():
                archived.rename(registered)
            if not root.exists() and not root.is_symlink():
                git("worktree", "move", str(registered), str(root), cwd=primary)
                slot.rmdir()
        finally:
            if slot.exists():
                print(f"Worktree files are retained at {slot}", file=sys.stderr)
        raise
    return archived


def end(root, primary):
    require_clean()
    branch = session_branch(root, primary)
    if config(OWNER) != branch or config("core.hooksPath") != str(git_path("homepodctl-session-hooks")):
        raise SessionError("end applies to worktrees with the session gate installed")
    base = fetch_main()
    require_no_grafts()
    head = git("rev-parse", "HEAD")
    result = check_ancestry(head, base)
    if result.returncode == 1:
        raise SessionError("the task commits are not on origin/main")
    result.check_returncode()
    require_clean()
    if session_branch(root, primary) != branch or git("rev-parse", "HEAD") != head:
        raise SessionError("the task branch changed during cleanup")
    protect_local_files()
    archived = retire_checkout(root, primary, branch, head)
    print(f"Worktree files moved to {archived}")
    print(f"Removed {root}")


def main():
    if Path(sys.argv[0]).name == "pre-push":
        os.environ["GIT_NO_REPLACE_OBJECTS"] = "1"
        if len(sys.argv) == 5 and sys.argv[1] == "--qualify":
            qualify(*sys.argv[2:])
        elif len(sys.argv) == 3:
            pre_push(sys.argv[2])
        else:
            raise SessionError("the pre-push gate must be invoked by Git")
        return
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("start", help="create a task worktree from origin/main").add_argument("name")
    commands.add_parser("list", help="list worktrees and their branches")
    landing = commands.add_parser("land", help="review, verify and fast-forward origin/main")
    landing.add_argument(
        "--dry-run", action="store_true", help="run the gate without updating GitHub"
    )
    landing.add_argument("--base", help="known main commit for adopting an unrecorded worktree")
    commands.add_parser("end", help="move this clean, landed task worktree to Trash")
    args = parser.parse_args()
    for key in checkout_environment_keys():
        os.environ.pop(key, None)
    os.environ["GIT_NO_REPLACE_OBJECTS"] = "1"
    root = Path(git("rev-parse", "--show-toplevel")).resolve()
    os.chdir(root)
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    if common.name != ".git":
        raise SessionError("expected a standard non-bare checkout")
    primary = common.parent
    if args.command == "list":
        print(git("worktree", "list"))
    elif args.command == "land":
        land(root, common, primary, args.dry_run, args.base)
    elif args.command == "start":
        with session_lock(common, "worktrees"):
            start(args.name, common, primary)
    else:
        with session_lock(common, "landing"), session_lock(common, "worktrees"):
            end(root, primary)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(f"scripts/session: Git exited {error.returncode}; see the diagnostics above")
    except (SessionError, OSError) as error:
        sys.exit(f"scripts/session: {error}")
